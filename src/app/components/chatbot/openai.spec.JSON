{
  "openapi": "3.0.0",
  "info": {
    "title": "SuperArigato API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://superarigatobot-middleware.onrender.com"
    }
  ],
  "paths": {
    "/product/{handle}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get product availability",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "description": "Product handle",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns product availability",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product_availability": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}