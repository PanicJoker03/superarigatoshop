{
  "name": "superarigatoshop",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:superarigatoshop": "node dist/superarigatoshop/server/server.mjs",
    "deploy": "ng build --configuration production",
    "githubpages-deploy": "ng build --configuration production --base-href \"/\" && npx angular-cli-ghpages --dir=dist/superarigatoshop/browser --repo=https://github.com/AegisHyper/superarigatoshop-deploy.git --branch=main"    
  },
  "old.scripts": {
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.13",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.6",
    "@apollo/client": "^4.0.1",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "@shopify/storefront-api-client": "^1.0.10",
    "apollo-angular": "^14.0.0",
    "apollo-link-context": "^1.0.20",
    "express": "^5.1.0",
    "graphql": "^16",
    "graphql-js-client": "^0.9.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
